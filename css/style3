/* Dark Panel Overlays (Ensures text readability over animated background) */
.site-header,
.hero .container,
.hero-card,
.card,
.stat-strip,
.share-section,
.site-footer .container,
#cookie-banner {
    background: rgba(20, 24, 33, 0.85) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 12px;
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    color: #e2e8f0;
}

.hero .container {
    padding: 32px !important;
    margin-bottom: 24px;
}

.site-header {
    margin: 16px auto;
    max-width: 1200px;
    padding: 8px 24px;
}

.site-footer {
    margin-top: 48px;
    padding: 32px 0;
}

/* Text & Link Contrast Fixes */
h1, h2, h3, h4, h5, h6, .brand, .num {
    color: #ffffff !important;
}

p, .lead, .label, .storage-note, td, th {
    color: #cbd5e1 !important;
}

.main-nav a, .site-footer a, a {
    color: #38bdf8 !important;
    text-decoration: none;
}

.main-nav a:hover, .site-footer a:hover, a:hover {
    color: #7dd3fc !important;
    text-decoration: underline;
}

/* Avatar Component */
.avatar-ring {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #1e293b;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
}

.avatar-ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Game Category Badges */
.badge-cs2 { background-color: #0d6efd !important; color: #ffffff !important; }
.badge-valorant { background-color: #dc3545 !important; color: #ffffff !important; }
.badge-lol { background-color: #ffc107 !important; color: #000000 !important; }
.badge-dota2 { background-color: #8b0000 !important; color: #ffffff !important; }
.badge-rl { background-color: #0dcaf0 !important; color: #000000 !important; }

/* Social Icons */
.social-links a {
    font-size: 1.25rem;
    color: #38bdf8 !important;
    text-decoration: none;
    transition: opacity 0.2s ease;
}

.social-links a:hover {
    opacity: 0.8;
}
